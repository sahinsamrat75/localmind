{
  "name": "localmind",
  "version": "0.2.0",
  "description": "Local-first semantic memory server for AI agents. An MCP server that stores and recalls memories entirely on your machine — including codebase-scale ingestion with HNSW vector search. No API keys, no cloud.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "localmind": "./dist/cli.js"
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "npm run build && node test/smoke-test.mjs",
    "test:isolation": "node test/isolation-test.mjs",
    "test:migration": "node test/migration-test.mjs",
    "test:chunker": "node test/chunker-test.mjs",
    "test:incremental": "node test/incremental-test.mjs",
    "test:budget": "node test/token-budget-test.mjs",
    "test:all": "npm run build && node test/smoke-test.mjs && node test/isolation-test.mjs && node test/migration-test.mjs && node test/chunker-test.mjs && node test/incremental-test.mjs && node test/token-budget-test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "embeddings",
    "local-first",
    "ai-agents",
    "sqlite"
  ],
  "author": "sahinsamrat75",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.2.0",
    "hnswlib-node": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
